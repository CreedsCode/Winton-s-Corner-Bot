# ── Postgres instance ────────────────────────────────────────────────────────
# Superuser credentials used by the Docker image to bootstrap the instance.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_strong_password

# ── API database (web app: auth-shim + PostgREST) ────────────────────────────
API_DB_NAME=wintondb
API_DATABASE_URL=postgresql://postgres:changeme_strong_password@postgres:5432/wintondb

# ── Bot database (discord-bot) ───────────────────────────────────────────────
# Created by the initial migration (db/migrations/20260424000000_create_bot_database.sql).
BOT_DB_NAME=botdb
BOT_DATABASE_URL=postgresql://postgres:changeme_strong_password@postgres:5432/botdb

# ── JWT (shared between auth-shim and PostgREST) ─────────────────────────────
# Must be ≥32 characters.
JWT_SECRET=changeme_at_least_32_chars_long_secret_here

# ── PostgREST (uses the authenticator role for RLS, not superuser) ────────────
AUTHENTICATOR_PASSWORD=changeme_authenticator_pass
PGRST_DB_URI=postgres://authenticator:changeme_authenticator_pass@postgres:5432/wintondb
PGRST_DB_SCHEMA=api
PGRST_DB_ANON_ROLE=anon
PGRST_DB_MAX_ROWS=1000

# ── Discord OAuth ─────────────────────────────────────────────────────────────
# Register at https://discord.com/developers/applications
# OAuth2 → Redirects: add DISCORD_REDIRECT_URI
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost/auth/discord/callback
FRONTEND_URL=http://localhost
